<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlantillasUsuario.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PlantillasUsuario.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Bienvenida"
        ContentTemplate="{DataTemplate views:BienvenidaPage}"
        Route="BienvenidaPage" />

    <ShellContent
        Title="Principal"
        ContentTemplate="{DataTemplate views:PrincipalPage}"
        Route="PrincipalPage" />

</Shell>