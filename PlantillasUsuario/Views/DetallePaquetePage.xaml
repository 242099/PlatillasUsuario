<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantillasUsuario.Views.DetallePaquetePage"
             BackgroundColor="#FAFAFA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12"
                                 Padding="0,0,0,22">

                <!-- 1. Banner Superior + Botones Regresar y Favorito -->
                <Grid HeightRequest="190">
                    <Image x:Name="imgPaquete"
                           Aspect="AspectFill"
                           HeightRequest="190" />

                    <!-- Botón Circular Blanco Regresar -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            HeightRequest="46"
                            WidthRequest="46"
                            Padding="10"
                            Margin="16,16,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="23" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="5"
                                    Opacity="0.25" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegresarTapped" />
                        </Border.GestureRecognizers>

                        <Image Source="flecha.png"
                               Aspect="AspectFit" />
                    </Border>

                    <!-- Botón Circular Blanco Favorito (Corazón) -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            HeightRequest="46"
                            WidthRequest="46"
                            Padding="10"
                            Margin="0,16,16,0"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="23" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="5"
                                    Opacity="0.25" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritoTapped" />
                        </Border.GestureRecognizers>

                        <Image x:Name="imgFavorito"
                               Source="amor.png"
                               Aspect="AspectFit" />
                    </Border>
                </Grid>

                <!-- Contenedor Principal de Tarjetas -->
                <VerticalStackLayout Padding="16,2,16,0"
                                     Spacing="12">

                    <!-- 2. Tarjeta Principal: Nombre, Panadería, Calificación, Horario y Precio -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="lblNombrePaquete"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111111" />

                            <Label x:Name="lblPanaderia"
                                   FontSize="13"
                                   TextColor="#555555" />

                            <Border BackgroundColor="#D1D1D1"
                                    StrokeThickness="0"
                                    Padding="8,3"
                                    Margin="0,2,0,4"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <HorizontalStackLayout Spacing="5"
                                                       VerticalOptions="Center">
                                    <Label Text="★"
                                           FontSize="13"
                                           TextColor="#111111"
                                           VerticalOptions="Center" />
                                    <Label x:Name="lblCalificacion"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#222222"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Horario y Precios -->
                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,2,0,0">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="1"
                                                     Margin="16,0,0,0">
                                    <Label Text="Horario de Atención"
                                           FontSize="11"
                                           TextColor="#333333" />
                                    <Label x:Name="lblHorario"
                                           FontSize="12"
                                           TextColor="#111111" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1"
                                                       Spacing="6"
                                                       VerticalOptions="End">
                                    <Label x:Name="lblPrecioAnterior"
                                           FontSize="13"
                                           TextColor="#333333"
                                           TextDecorations="Strikethrough"
                                           VerticalOptions="End"
                                           Margin="0,0,0,3" />

                                    <Label x:Name="lblPrecioActual"
                                           FontSize="21"
                                           FontAttributes="Bold"
                                           TextColor="#111111"
                                           VerticalOptions="End" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Tarjeta Acerca del paquete -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">
                                <Image Source="bolsa.png"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       Aspect="AspectFit" />
                                <Label Text="Acerca del paquete"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="Recibirás un paquete sorpresa con una selección de productos horneados del día en excelente estado. El contenido varía diariamente según la producción."
                                   FontSize="12.5"
                                   TextColor="#222222"
                                   LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. Tarjeta Experiencia general (Barras de calificación) -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">
                                <Image Source="grafico_circular.png"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       Aspect="AspectFit" />
                                <Label Text="Experiencia general"
                                       FontSize="13"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Fila Entrega 4.9 -->
                            <Grid ColumnDefinitions="70,*,30"
                                  ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="Entrega"
                                       FontSize="12"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />

                                <ProgressBar Grid.Column="1"
                                             Progress="0.98"
                                             ProgressColor="#C98365"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="4.9"
                                       FontSize="12"
                                       TextColor="#666666"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Fila Calidad 4.6 -->
                            <Grid ColumnDefinitions="70,*,30"
                                  ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="Calidad"
                                       FontSize="12"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />

                                <ProgressBar Grid.Column="1"
                                             Progress="0.72"
                                             ProgressColor="#C98365"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="4.6"
                                       FontSize="12"
                                       TextColor="#666666"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Fila Cantidad 4.5 -->
                            <Grid ColumnDefinitions="70,*,30"
                                  ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="Cantidad"
                                       FontSize="12"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />

                                <ProgressBar Grid.Column="1"
                                             Progress="0.52"
                                             ProgressColor="#C98365"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="4.5"
                                       FontSize="12"
                                       TextColor="#666666"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 5. Tarjeta Instrucciones y Envase -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">
                                <Image Source="briefing.png"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       Aspect="AspectFit" />
                                <Label Text="Instrucciones y Envase"
                                       FontSize="13"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="3"
                                                 Margin="4,2,0,0">
                                <Label Text="1. Muestra tu pedido en la app al llegar a la tienda"
                                       FontSize="12.5"
                                       TextColor="#444444" />

                                <Label FontSize="12.5"
                                       TextColor="#444444">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="2. " />
                                            <Span Text="Envase:" FontAttributes="Bold" TextColor="#222222" />
                                            <Span Text=" Incluido por el comercio" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="12.5"
                                       TextColor="#444444">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="3. " />
                                            <Span Text="Bolsa:" FontAttributes="Bold" TextColor="#222222" />
                                            <Span Text=" Recomendamos llevar tu propia bolsa" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 6. Tarjeta Ubicación y Botón Cómo llegar -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="16">

                            <!-- Píldora gris con ícono ubicación y nombre de panadería -->
                            <Border BackgroundColor="#DCDCDC"
                                    StrokeThickness="0"
                                    Padding="12,6"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <HorizontalStackLayout Spacing="8"
                                                       VerticalOptions="Center">
                                    <Image Source="localizacion.png"
                                           HeightRequest="24"
                                           WidthRequest="24"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center" />

                                    <Label x:Name="lblPanaderiaUbicacion"
                                           FontSize="12.5"
                                           TextColor="#222222"
                                           HorizontalTextAlignment="Center"
                                           MaximumWidthRequest="140"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Botón con borde terracota "Como llegar" -->
                            <Button Text="Como llegar"
                                    Clicked="OnComoLlegarClicked"
                                    BackgroundColor="Transparent"
                                    BorderColor="#B5522D"
                                    BorderWidth="1.2"
                                    TextColor="#B5522D"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    HorizontalOptions="Fill" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 7. Barra Inferior Fija: Total a pagar + Botón Reservar -->
        <Border Grid.Row="1"
                BackgroundColor="#F5F5F5"
                Stroke="#DCDCDC"
                StrokeThickness="1"
                Padding="20,10,20,12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">

                <VerticalStackLayout Grid.Column="0"
                                     VerticalOptions="Center"
                                     Spacing="1">
                    <Label Text="Total a pagar"
                           FontSize="12"
                           TextColor="#666666" />
                    <Label x:Name="lblTotalPagar"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#B5522D" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Reservar"
                        Clicked="OnReservarClicked"
                        BackgroundColor="#C85A28"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="21"
                        CornerRadius="10"
                        HeightRequest="48"
                        WidthRequest="165"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>