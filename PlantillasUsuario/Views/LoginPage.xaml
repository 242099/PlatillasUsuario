<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantillasUsuario.Views.LoginPage"
             BackgroundColor="#FAF5F0"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="32,50,32,30"
                             Spacing="18"
                             VerticalOptions="Center">

            <!-- Logotipo y Título -->
            <VerticalStackLayout Spacing="6"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,18">
                <Image Source="logo_provecha.png"
                       HeightRequest="155"
                       WidthRequest="155"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <Label Text="PROVECHA"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#111111"
                       CharacterSpacing="1"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Campo Correo Electrónico -->
            <VerticalStackLayout Spacing="6">
                <Label Text="CORREO ELECTRONICO"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#B5522D"
                       Margin="2,0,0,0" />

                <Border Stroke="#4A3F3A"
                        StrokeThickness="1.2"
                        BackgroundColor="White"
                        HeightRequest="46"
                        Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Entry x:Name="txtCorreo"
                           Keyboard="Email"
                           ReturnType="Next"
                           TextColor="#1E1E1E"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Campo Contraseña -->
            <VerticalStackLayout Spacing="6">
                <Label Text="CONTRASEÑA"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#B5522D"
                       Margin="2,0,0,0" />

                <Border Stroke="#4A3F3A"
                        StrokeThickness="1.2"
                        BackgroundColor="White"
                        HeightRequest="46"
                        Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Entry x:Name="txtContrasena"
                           IsPassword="True"
                           ReturnType="Done"
                           TextColor="#1E1E1E"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Botón Iniciar Sesión -->
            <Button Text="Iniciar Sesión"
                    Clicked="OnIniciarSesionClicked"
                    BackgroundColor="#B5522D"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="20"
                    CornerRadius="16"
                    HeightRequest="54"
                    WidthRequest="260"
                    HorizontalOptions="Center"
                    Margin="0,28,0,24" />

            <!-- Enlace a Registro -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="5">
                <Label Text="¿No tiene cuenta?"
                       FontSize="16"
                       TextColor="#111111" />

                <Label Text="Regístrate"
                       FontSize="16"
                       TextColor="#111111"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegistrateTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>