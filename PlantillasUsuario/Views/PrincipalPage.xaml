<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PlantillasUsuario.Models"
             xmlns:services="clr-namespace:PlantillasUsuario.Services"
             x:Class="PlantillasUsuario.Views.PrincipalPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- PLANTILLA 0: INICIO -->
        <DataTemplate x:Key="InicioViewTemplate">
            <Grid RowDefinitions="Auto,*">
                <!-- Encabezado Ubicación y Perfil -->
                <VerticalStackLayout Grid.Row="0"
                                     Padding="20,18,20,10"
                                     Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <Image Source="localizacion.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="Atlixco,Puebla"
                                   FontSize="16"
                                   TextColor="#111111"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border Grid.Column="1"
                                HeightRequest="52"
                                WidthRequest="52"
                                Stroke="#FF7A00"
                                StrokeThickness="2.5"
                                BackgroundColor="White"
                                Padding="6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPerfilTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="avatar.png"
                                   Aspect="AspectFit" />
                        </Border>
                    </Grid>

                    <Label Text="Paquetes recomendados"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#111111" />
                </VerticalStackLayout>

                <!-- Lista de Paquetes -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{x:Static services:DatosSimulados.Paquetes}"
                                Margin="20,0,20,0"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="16" Color="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PaqueteSorpresa">
                            <Border Stroke="#E2E2E2"
                                    StrokeThickness="1"
                                    BackgroundColor="#F5F5F5"
                                    Margin="2,2,2,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Offset="0,3"
                                            Radius="6"
                                            Opacity="0.18" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPaqueteTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="135,Auto">
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding Imagen}"
                                               Aspect="AspectFill"
                                               HeightRequest="135" />
                                        <Border BackgroundColor="#EE3B3B"
                                                StrokeThickness="0"
                                                Padding="10,4"
                                                Margin="10,10,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Descuento}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1"
                                                         Padding="12,8,12,10"
                                                         Spacing="3">
                                        <Label Text="{Binding Panaderia}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#B5522D"
                                               TextDecorations="Underline"
                                               Padding="0,3">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPanaderiaNombreTapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label Text="{Binding NombrePaquete}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#111111" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,4,0,0">
                                            <HorizontalStackLayout Grid.Column="0"
                                                                   Spacing="6"
                                                                   VerticalOptions="Center">
                                                <Image Source="reloj.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       Aspect="AspectFit" />
                                                <Label Text="{Binding Horario}"
                                                       FontSize="11"
                                                       TextColor="#222222"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1"
                                                                   Spacing="6"
                                                                   VerticalOptions="End">
                                                <Label Text="{Binding PrecioAnterior}"
                                                       FontSize="11"
                                                       TextColor="#444444"
                                                       TextDecorations="Strikethrough"
                                                       VerticalOptions="End"
                                                       Margin="0,0,0,2" />
                                                <Label Text="{Binding PrecioActual}"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       TextColor="#111111"
                                                       VerticalOptions="End" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </DataTemplate>

        <!-- PLANTILLA 1: MIS PEDIDOS -->
        <DataTemplate x:Key="PedidosViewTemplate">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0"
                       Text="Mis Pedidos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111111"
                       HorizontalOptions="Center"
                       Margin="0,24,0,16" />

                <CollectionView Grid.Row="1"
                                ItemsSource="{x:Static services:DatosSimulados.Pedidos}"
                                Margin="22,4,22,0"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="18" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="10"
                                             Padding="24">
                            <Image Source="bolsa.png"
                                   HeightRequest="56"
                                   WidthRequest="56"
                                   Opacity="0.45"
                                   HorizontalOptions="Center" />
                            <Label Text="Aún no tienes pedidos"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#444444"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Cuando reserves un paquete sorpresa aparecerá aquí con su código de recolección."
                                   FontSize="13"
                                   TextColor="#777777"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="18" Color="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PedidoReservado">
                            <Border BackgroundColor="#F7F7F7"
                                    Stroke="#EAEAEA"
                                    StrokeThickness="1"
                                    Padding="16,12"
                                    Margin="2,2,2,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Offset="0,3"
                                            Radius="6"
                                            Opacity="0.16" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPedidoTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#B5522D"
                                                StrokeThickness="0"
                                                Padding="14,4"
                                                HorizontalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Estado}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding FechaTexto}"
                                               FontSize="12"
                                               TextColor="#333333"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{Binding Paquete.NombrePaquete}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111111"
                                           Margin="4,4,0,0" />

                                    <Label Text="{Binding Paquete.Panaderia}"
                                           FontSize="12"
                                           TextColor="#555555"
                                           Margin="4,0,0,2" />

                                    <Label Text="{Binding Paquete.PrecioActual}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#B5522D"
                                           Margin="4,2,0,6" />

                                    <BoxView HeightRequest="1"
                                             BackgroundColor="#4A4A4A"
                                             Margin="4,0,4,6" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          Margin="10,0,6,0">
                                        <Label Grid.Column="0"
                                               Text="Código:"
                                               FontSize="10.5"
                                               FontAttributes="Bold"
                                               TextColor="#555555" />
                                        <Label Grid.Column="1"
                                               Text="{Binding CodigoFormateado}"
                                               FontSize="10.5"
                                               FontAttributes="Bold"
                                               TextColor="#555555"
                                               HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </DataTemplate>

        <!-- PLANTILLA 2: MIS FAVORITOS -->
        <DataTemplate x:Key="FavoritosViewTemplate">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0"
                       Text="Mis Favoritos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111111"
                       HorizontalOptions="Center"
                       Margin="0,24,0,16" />

                <CollectionView Grid.Row="1"
                                ItemsSource="{x:Static services:DatosSimulados.FavoritosActivos}"
                                Margin="20,4,20,0"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="18" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="10"
                                             Padding="24">
                            <Image Source="amor.png"
                                   HeightRequest="56"
                                   WidthRequest="56"
                                   Opacity="0.45"
                                   HorizontalOptions="Center" />
                            <Label Text="Aún no tienes favoritos"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#444444"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Toca el ícono de corazón dentro de cualquier paquete sorpresa para guardarlo aquí."
                                   FontSize="13"
                                   TextColor="#777777"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="18" Color="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PaqueteSorpresa">
                            <Border BackgroundColor="#FAF6F4"
                                    Stroke="#E6E0DC"
                                    StrokeThickness="1"
                                    Margin="2,2,2,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Offset="0,3"
                                            Radius="6"
                                            Opacity="0.16" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTarjetaFavoritoTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="140,Auto">
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding Imagen}"
                                               Aspect="AspectFill"
                                               HeightRequest="140" />
                                        <Border BackgroundColor="{Binding ColorEstado}"
                                                StrokeThickness="0"
                                                Padding="14,3"
                                                Margin="10,10,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TextoEstado}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#111111" />
                                        </Border>

                                        <Border BackgroundColor="White"
                                                StrokeThickness="0"
                                                HeightRequest="42"
                                                WidthRequest="42"
                                                Padding="9"
                                                Margin="0,8,10,0"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="21" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnQuitarFavoritoTapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="corazon.png"
                                                   Aspect="AspectFit" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1"
                                                         Padding="12,8,12,12"
                                                         Spacing="6">
                                        <Label Text="{Binding Panaderia}"
                                               FontSize="13.5"
                                               FontAttributes="Bold"
                                               TextColor="#111111" />

                                        <Border BackgroundColor="Transparent"
                                                Stroke="#BDBDBD"
                                                StrokeThickness="1.2"
                                                StrokeDashArray="5,4"
                                                Padding="10,8"
                                                Margin="4,2,4,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding NombrePaquete}"
                                                       FontSize="11.5"
                                                       TextColor="#222222" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding HorarioRecoger}"
                                                           FontSize="11"
                                                           TextColor="#222222"
                                                           VerticalOptions="End" />
                                                    <HorizontalStackLayout Grid.Column="1"
                                                                           Spacing="5"
                                                                           VerticalOptions="End">
                                                        <Label Text="{Binding PrecioAnterior}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="#B5522D"
                                                               TextDecorations="Strikethrough"
                                                               VerticalOptions="End"
                                                               Margin="0,0,0,2" />
                                                        <Label Text="{Binding PrecioActual}"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="#B5522D"
                                                               VerticalOptions="End" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </DataTemplate>

        <models:SeccionPrincipalSelector x:Key="SeccionSelector"
                                         InicioTemplate="{StaticResource InicioViewTemplate}"
                                         PedidosTemplate="{StaticResource PedidosViewTemplate}"
                                         FavoritosTemplate="{StaticResource FavoritosViewTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- 1. Carrusel Deslizante con las 3 Secciones -->
        <CarouselView x:Name="carruselPrincipal"
                      Grid.Row="0"
                      Loop="False"
                      ItemTemplate="{StaticResource SeccionSelector}"
                      PositionChanged="OnCarruselPositionChanged" />

        <!-- 2. Barra de Navegación Inferior Fija con Indicador Sombreado -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Stroke="#DCDCDC"
                StrokeThickness="1"
                Padding="10,8,10,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18,18,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,-3"
                        Radius="8"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">

                <!-- Pestaña Inicio -->
                <Border x:Name="tabInicio"
                        Grid.Column="0"
                        BackgroundColor="#FBECE6"
                        StrokeThickness="0"
                        Padding="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="casa.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label x:Name="lblTabInicio"
                               Text="Inicio"
                               FontSize="12.5"
                               FontAttributes="Bold"
                               TextColor="#B5522D"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pestaña Pedidos -->
                <Border x:Name="tabPedidos"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedidosTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="bolsa.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label x:Name="lblTabPedidos"
                               Text="Pedidos"
                               FontSize="12.5"
                               TextColor="#111111"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pestaña Favoritos -->
                <Border x:Name="tabFavoritos"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritosTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="amor.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label x:Name="lblTabFavoritos"
                               Text="Favoritos"
                               FontSize="12.5"
                               TextColor="#111111"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>