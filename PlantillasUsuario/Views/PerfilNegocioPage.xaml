<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PlantillasUsuario.Models"
             x:Class="PlantillasUsuario.Views.PerfilNegocioPage"
             BackgroundColor="#FAFAFA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14"
                                 Padding="0,0,0,24">

                <!-- 1. Banner Superior de la Panadería + Botón Regresar -->
                <Grid HeightRequest="195">
                    <Image x:Name="imgBanner"
                           Aspect="AspectFill"
                           HeightRequest="195" />

                    <!-- Botón Circular Blanco Regresar -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            HeightRequest="48"
                            WidthRequest="48"
                            Padding="10"
                            Margin="16,16,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="5"
                                    Opacity="0.25" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegresarTapped" />
                        </Border.GestureRecognizers>

                        <Image Source="flecha.png"
                               Aspect="AspectFit" />
                    </Border>
                </Grid>

                <!-- Contenedor Principal con Márgenes Laterales -->
                <VerticalStackLayout Padding="18,4,18,0"
                                     Spacing="12">

                    <!-- 2. Tarjeta Nombre y Calificación -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="lblNombreNegocio"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#111111" />

                            <Border BackgroundColor="#D1D1D1"
                                    StrokeThickness="0"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <HorizontalStackLayout Spacing="6"
                                                       VerticalOptions="Center">
                                    <Label Text="★"
                                           FontSize="15"
                                           TextColor="#111111"
                                           VerticalOptions="Center" />
                                    <Label x:Name="lblCalificacion"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#222222"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Tarjeta Horario de Atención -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="reloj.png"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="Horario de Atención:"
                                   FontSize="13"
                                   TextColor="#222222"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Label Text="Hoy de"
                                       FontSize="11"
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="lblHoras"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- 4. Tarjeta Dirección -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="localizacion.png"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   Aspect="AspectFit"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">
                                <Label Text="Dirección:"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#111111" />
                                <Label x:Name="lblDireccion"
                                       FontSize="13"
                                       TextColor="#222222" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- 5. Dos Tarjetas Rosadas de Estadísticas / Impacto -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14"
                          Margin="0,4,0,4">

                        <!-- Tarjeta Izquierda: Tiempo -->
                        <Border Grid.Column="0"
                                BackgroundColor="#FFF0EA"
                                Stroke="#F29F89"
                                StrokeThickness="1.2"
                                Padding="12,16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                <Image Source="tierra.png"
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />

                                <Label x:Name="lblTiempoPlataforma"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="Luchando contra el desperdicio alimentario"
                                       FontSize="12"
                                       TextColor="#222222"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tarjeta Derecha: Paquetes Salvados -->
                        <Border Grid.Column="1"
                                BackgroundColor="#FFF0EA"
                                Stroke="#F29F89"
                                StrokeThickness="1.2"
                                Padding="12,16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                <Image Source="bolsa_de_la_compra.png"
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />

                                <Label x:Name="lblPaquetesSalvados"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="Paquetes salvados"
                                       FontSize="12"
                                       TextColor="#222222"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- 6. Tarjeta Acerca del establecimiento -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="#E2E2E2"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.14" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">
                                <Image Source="acerca_de.png"
                                       HeightRequest="22"
                                       WidthRequest="22"
                                       Aspect="AspectFit" />
                                <Label Text="Acerca del establecimiento"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label x:Name="lblAcercaDe"
                                   FontSize="13"
                                   TextColor="#222222"
                                   LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 7. Título Paquetes de este establecimiento -->
                    <Label Text="Paquetes de este establecimiento"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           Margin="0,6,0,2" />

                    <!-- Lista de paquetes de esta panadería -->
                    <VerticalStackLayout x:Name="listaPaquetesNegocio"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PaqueteSorpresa">
                                <Border BackgroundColor="#F3F3F3"
                                        Stroke="#E2E2E2"
                                        StrokeThickness="1"
                                        Padding="14,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000"
                                                Offset="0,2"
                                                Radius="4"
                                                Opacity="0.14" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPaqueteNegocioTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Panaderia}"
                                               FontSize="13"
                                               TextColor="#555555" />

                                        <Label Text="{Binding NombrePaquete}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#111111" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,4,0,0">
                                            <HorizontalStackLayout Grid.Column="0"
                                                                   Spacing="6"
                                                                   VerticalOptions="Center">
                                                <Image Source="reloj.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       Aspect="AspectFit" />
                                                <Label Text="{Binding Horario}"
                                                       FontSize="11"
                                                       TextColor="#222222"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1"
                                                                   Spacing="6"
                                                                   VerticalOptions="End">
                                                <Label Text="{Binding PrecioAnterior}"
                                                       FontSize="11"
                                                       TextColor="#444444"
                                                       TextDecorations="Strikethrough"
                                                       VerticalOptions="End"
                                                       Margin="0,0,0,2" />

                                                <Label Text="{Binding PrecioActual}"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       TextColor="#111111"
                                                       VerticalOptions="End" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 8. Barra de Navegación Inferior -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Stroke="#DCDCDC"
                StrokeThickness="1"
                Padding="10,8,10,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18,18,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,-3"
                        Radius="8"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioNavTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="casa.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Inicio"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedidosNavTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="bolsa.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Pedidos"
                           FontSize="13"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritosNavTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="amor.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Favoritos"
                           FontSize="13"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>