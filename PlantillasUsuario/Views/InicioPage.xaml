<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PlantillasUsuario.Models"
             x:Class="PlantillasUsuario.Views.InicioPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Encabezado Superior: Ubicación y Perfil -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,18,20,10"
                             Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <!-- Ubicación -->
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="6"
                                       VerticalOptions="Center">
                    <Image Source="localizacion.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           Aspect="AspectFit"
                           VerticalOptions="Center" />

                    <Label Text="Atlixco,Puebla"
                           FontSize="16"
                           TextColor="#111111"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Botón Perfil Naranja -->
                <Border Grid.Column="1"
                        HeightRequest="52"
                        WidthRequest="52"
                        Stroke="#FF7A00"
                        StrokeThickness="2.5"
                        BackgroundColor="White"
                        Padding="6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped" />
                    </Border.GestureRecognizers>

                    <Image Source="avatar.png"
                           Aspect="AspectFit" />
                </Border>
            </Grid>

            <!-- Título Sección -->
            <Label Text="Paquetes recomendados"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#111111" />
        </VerticalStackLayout>

        <!-- 2. Lista Desplazable de Paquetes -->
        <CollectionView x:Name="cvPaquetes"
                        Grid.Row="1"
                        Margin="20,0,20,0"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PaqueteSorpresa">
                    <Border Stroke="#E2E2E2"
                            StrokeThickness="1"
                            BackgroundColor="#F5F5F5"
                            Margin="2,2,2,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,3"
                                    Radius="6"
                                    Opacity="0.18" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPaqueteTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="135,Auto">

                            <!-- Imagen de la Panadería + Etiqueta Roja de Descuento -->
                            <Grid Grid.Row="0">
                                <Image Source="{Binding Imagen}"
                                       Aspect="AspectFill"
                                       HeightRequest="135" />

                                <Border BackgroundColor="#EE3B3B"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        Margin="10,10,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding Descuento}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <!-- Datos Inferiores de la Tarjeta -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="12,8,12,10"
                                                 Spacing="3">

                                <Label Text="{Binding Panaderia}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#B5522D"
                                       TextDecorations="Underline"
                                       Padding="0,3">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPanaderiaNombreTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label Text="{Binding NombrePaquete}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#111111" />

                                <!-- Fila Inferior: Reloj + Horario a la izquierda | Precios a la derecha -->
                                <Grid ColumnDefinitions="*,Auto"
                                      Margin="0,4,0,0">

                                    <HorizontalStackLayout Grid.Column="0"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Image Source="reloj.png"
                                               HeightRequest="20"
                                               WidthRequest="20"
                                               Aspect="AspectFit" />

                                        <Label Text="{Binding Horario}"
                                               FontSize="11"
                                               TextColor="#222222"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="6"
                                                           VerticalOptions="End">
                                        <Label Text="{Binding PrecioAnterior}"
                                               FontSize="11"
                                               TextColor="#444444"
                                               TextDecorations="Strikethrough"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2" />

                                        <Label Text="{Binding PrecioActual}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="#111111"
                                               VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. Barra de Navegación Inferior -->
        <Border Grid.Row="2"
                BackgroundColor="#FFFFFF"
                Stroke="#DCDCDC"
                StrokeThickness="1"
                Padding="10,8,10,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18,18,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,-3"
                        Radius="8"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">

                <!-- Pestaña Inicio (ACTIVA con sombreado) -->
                <Border Grid.Column="0"
                        BackgroundColor="#FBECE6"
                        StrokeThickness="0"
                        Padding="0,6"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="casa.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Text="Inicio"
                               FontSize="12.5"
                               FontAttributes="Bold"
                               TextColor="#B5522D"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pestaña Pedidos (Inactiva) -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="0,6"
                        HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedidosTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="bolsa.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Text="Pedidos"
                               FontSize="12.5"
                               TextColor="#111111"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pestaña Favoritos (Inactiva) -->
                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="0,6"
                        HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritosTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">
                        <Image Source="amor.png"
                               HeightRequest="30"
                               WidthRequest="30"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Text="Favoritos"
                               FontSize="12.5"
                               TextColor="#111111"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>