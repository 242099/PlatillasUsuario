<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantillasUsuario.Views.PagoEfectivoPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20,16,20,24">

        <!-- Flecha Regresar -->
        <ImageButton Grid.Row="0"
                     Source="flecha.png"
                     Clicked="OnRegresarClicked"
                     HeightRequest="34"
                     WidthRequest="34"
                     HorizontalOptions="Start"
                     BackgroundColor="Transparent"
                     Margin="0,0,0,14" />

        <!-- Contenedor Confirmar Pago en Efectivo -->
        <Border Grid.Row="1"
                BackgroundColor="#F8F8F8"
                Stroke="#EEEEEE"
                StrokeThickness="1"
                Padding="16,20"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="16">
                <Label Text="Confirmar Pago en Efectivo"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#111111" />

                <!-- Alerta Amarilla Confirmación de Recolección -->
                <Border BackgroundColor="#FFF4D9"
                        Stroke="#F4C462"
                        StrokeThickness="1.2"
                        Padding="12,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">
                            <Image Source="crisis.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   Aspect="AspectFit" />
                            <Label Text="Confirmación de Recolección"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#A65A17"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="El comercio guardará tu paquete sorpresa exclusivamente para ti. Si no acudes a pagar en caja, la comida podría desperdiciarse."
                               FontSize="11.5"
                               TextColor="#A65A17"
                               Margin="22,0,0,0"
                               LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta Monto y Horario Límite -->
                <Border BackgroundColor="#F3F3F3"
                        Stroke="#E2E2E2"
                        StrokeThickness="1"
                        Padding="14,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,2"
                                Radius="5"
                                Opacity="0.14" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Monto a pagar en caja:"
                                   FontSize="13"
                                   TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Label x:Name="lblMontoCaja"
                                   Grid.Column="1"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#B5522D"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Horario límite de entrega:"
                                   FontSize="13"
                                   TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Label x:Name="lblHorarioLimite"
                                   Grid.Column="1"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#111111"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Casilla de Compromiso -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="6"
                      Margin="0,6,0,0">
                    <CheckBox x:Name="chkCompromiso"
                              Grid.Column="0"
                              Color="#C85A28"
                              VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="Me comprometo a acudir al establecimiento y pagar en efectivo dentro del horario indicado."
                           FontSize="10.5"
                           TextColor="#666666"
                           VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Enlace Cambiar método + Botón Confirmar Reserva -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="14">

            <Label Text="←Cambiar método de pago"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#C85A28"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCambiarMetodoTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Confirmar Reserva en efectivo"
                    Clicked="OnConfirmarEfectivoClicked"
                    BackgroundColor="#C85A28"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="12"
                    HeightRequest="50" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>