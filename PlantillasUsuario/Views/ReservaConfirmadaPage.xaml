<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantillasUsuario.Views.ReservaConfirmadaPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="22,38,22,24">

        <!-- 1. Banner Superior Terracota (PAGADO CON TARJETA / PAGADO CON EFECTIVO) -->
        <Border Grid.Row="0"
                BackgroundColor="#C85A28"
                StrokeThickness="0"
                HeightRequest="46"
                Margin="0,0,0,26">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,3"
                        Radius="5"
                        Opacity="0.22" />
            </Border.Shadow>

            <Label x:Name="lblBannerMetodo"
                   Text="PAGADO CON TARJETA"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- 2. Tarjeta Central de Confirmación y Código -->
        <Border Grid.Row="1"
                BackgroundColor="#F8F8F8"
                Stroke="#EAEAEA"
                StrokeThickness="1"
                Padding="20,26,20,24"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,3"
                        Radius="6"
                        Opacity="0.16" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <!-- Encabezado !Reserva Confirmada! -->
                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="!Reserva Confirmada!"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Muestre este código al recoger tu&#x0a;paquete."
                           FontSize="12"
                           TextColor="#222222"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.2" />
                </VerticalStackLayout>

                <!-- Recuadro Punteado con el Código de Pedido -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#D98B68"
                        StrokeThickness="1.5"
                        StrokeDashArray="5,4"
                        HeightRequest="96"
                        Margin="8,2,8,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>

                    <Label x:Name="lblCodigoPedido"
                           Text="3794-2026"
                           FontSize="36"
                           TextColor="#111111"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Lista de Detalles de la Reserva -->
                <VerticalStackLayout Spacing="4"
                                     Margin="10,0,0,0">
                    <Label x:Name="lblPanaderia"
                           FontSize="12"
                           TextColor="#222222" />

                    <Label x:Name="lblHorarioLimite"
                           FontSize="12"
                           TextColor="#222222" />

                    <Label x:Name="lblPaquete"
                           FontSize="12"
                           TextColor="#222222" />

                    <Label x:Name="lblMonto"
                           FontSize="12"
                           TextColor="#222222" />
                </VerticalStackLayout>

                <!-- Botón Como llegar -->
                <Button Text="Como llegar"
                        Clicked="OnComoLlegarClicked"
                        BackgroundColor="#C85A28"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="12"
                        HeightRequest="46"
                        WidthRequest="165"
                        HorizontalOptions="Center"
                        Margin="0,6,0,0" />

            </VerticalStackLayout>
        </Border>

        <!-- 3. Botón Inferior Ver mis pedidos -->
        <Button Grid.Row="2"
                Text="Ver mis pedidos"
                Clicked="OnVerMisPedidosClicked"
                BackgroundColor="#C85A28"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="20"
                CornerRadius="12"
                HeightRequest="50" />

    </Grid>
</ContentPage>