<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantillasUsuario.Views.PerfilUsuarioPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Encabezado Superior -->
        <Label Grid.Row="0"
               Text="Mi Perfil"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#111111"
               HorizontalOptions="Center"
               Margin="0,24,0,20" />

        <!-- 2. Contenido Central del Perfil -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="26,10,26,20"
                             Spacing="18"
                             HorizontalOptions="Fill">

            <!-- Ícono Circular Naranja de Usuario -->
            <Border HeightRequest="120"
                    WidthRequest="120"
                    Stroke="#FF7A00"
                    StrokeThickness="5"
                    BackgroundColor="White"
                    Padding="14"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="60" />
                </Border.StrokeShape>

                <Image Source="avatar.png"
                       Aspect="AspectFit" />
            </Border>

            <!-- Nombre y Correo -->
            <VerticalStackLayout Spacing="2"
                                 HorizontalOptions="Center">
                <Label x:Name="lblNombreUsuario"
                       Text="Daniel Ortega"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111111"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="lblCorreoUsuario"
                       Text="daniel.ortega@ejemplo.com"
                       FontSize="13.5"
                       TextColor="#555555"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Dos Tarjetas de Resumen: Paquetes y Ahorrados -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="22"
                  Margin="6,4,6,14">

                <!-- Tarjeta Paquetes -->
                <Border Grid.Column="0"
                        BackgroundColor="#FAFAFA"
                        Stroke="#B8B8B8"
                        StrokeThickness="1"
                        Padding="12,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4"
                                         HorizontalOptions="Center">
                        <Label x:Name="lblTotalPaquetes"
                               Text="2"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#C85A28"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Paquetes"
                               FontSize="12"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta Ahorrados -->
                <Border Grid.Column="1"
                        BackgroundColor="#FAFAFA"
                        Stroke="#B8B8B8"
                        StrokeThickness="1"
                        Padding="12,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4"
                                         HorizontalOptions="Center">
                        <Label x:Name="lblTotalAhorrado"
                               Text="$80"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#C85A28"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Ahorrados"
                               FontSize="12"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Botón / Tarjeta Métodos de pago -->
            <Border BackgroundColor="#F7F7F7"
                    Stroke="#EAEAEA"
                    StrokeThickness="1"
                    Padding="16,14"
                    Margin="0,6,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,3"
                            Radius="6"
                            Opacity="0.16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMetodosPagoTapped" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">
                    <Image Grid.Column="0"
                           Source="tarjeta_bancaria.png"
                           HeightRequest="30"
                           WidthRequest="30"
                           Aspect="AspectFit"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="Métodos de pago"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           VerticalOptions="Center" />

                    <Label Grid.Column="2"
                           Text=">"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- 3. Barra de Navegación Inferior -->
        <Border Grid.Row="2"
                BackgroundColor="#FFFFFF"
                Stroke="#DCDCDC"
                StrokeThickness="1"
                Padding="10,8,10,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18,18,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,-3"
                        Radius="8"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="casa.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Inicio"
                           FontSize="13"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedidosTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="bolsa.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Pedidos"
                           FontSize="13"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="3"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritosTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="amor.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Favoritos"
                           FontSize="13"
                           TextColor="#111111"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>